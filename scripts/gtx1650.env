# Hardware profile for NVIDIA GTX 1650 (4 GB) + 8 GB RAM.
# Qwen3-4B 4-bit DPO needs ~9–12 GB; this box trains a 0.5B instruct model in fp16.
# Source before make pipeline:  set -a && source scripts/gtx1650.env && set +a
COMPUTE_TIER=T4
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LOAD_IN_4BIT=0
MAX_LEN=128
SFT_SLICE=200
PREF_TRAIN=200
PREF_EVAL=100
GEN_MAX_NEW_TOKENS=64
JUDGE_PROMPTS=50
DPO_BETA=0.1
DPO_LR=5e-6
DPO_EPOCHS=1
# Skywork 3B/4B fp16 do not fit 4 GB. Deberta RM is ~1.4 GB and loads on this GPU.
JUDGE_PROVIDER=rm
JUDGE_RM_MODELS=OpenAssistant/reward-model-deberta-v3-large-v2
MPLBACKEND=Agg
TOKENIZERS_PARALLELISM=false
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
